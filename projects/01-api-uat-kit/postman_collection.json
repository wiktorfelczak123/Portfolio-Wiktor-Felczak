{
  "info": {
    "_postman_id": "80bcdcd0-b447-4e0e-a8a7-5e3b8a120101",
    "name": "Portfolio API and UAT Demo",
    "description": "Local fictional API. Start mock_server.py and set baseUrl to http://127.0.0.1:4010.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:4010"
    },
    {
      "key": "deliveryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"status is ok\", () => pm.expect(body.status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Create delivery",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/deliveries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "deliveries"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicle_registration\": \"PO12345\",\n  \"client_reference\": \"POSTMAN-1001\",\n  \"customer_id\": \"CLIENT-001\",\n  \"volume_m3\": 8.2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"created record has id\", () => pm.expect(body.id).to.be.a(\"string\"));",
              "pm.environment.set(\"deliveryId\", body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Missing registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/deliveries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "deliveries"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_reference\": \"POSTMAN-MISSING\",\n  \"customer_id\": \"CLIENT-001\",\n  \"volume_m3\": 8.2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"validation error\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Negative volume",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/deliveries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "deliveries"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicle_registration\": \"PO12345\",\n  \"client_reference\": \"POSTMAN-NEGATIVE\",\n  \"customer_id\": \"CLIENT-001\",\n  \"volume_m3\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"validation error\", () => pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Retrieve created delivery",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/deliveries/{{deliveryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "deliveries",
            "{{deliveryId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"id matches environment\", () => pm.expect(pm.response.json().id).to.eql(pm.environment.get(\"deliveryId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Duplicate client reference",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/deliveries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "deliveries"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicle_registration\": \"PO12345\",\n  \"client_reference\": \"POSTMAN-1001\",\n  \"customer_id\": \"CLIENT-001\",\n  \"volume_m3\": 8.2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"duplicate error\", () => pm.expect(pm.response.json().error.code).to.eql(\"DUPLICATE_REFERENCE\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Unknown delivery",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/deliveries/00000000-0000-4000-8000-000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "deliveries",
            "00000000-0000-4000-8000-000000000000"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"not found error\", () => pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"));"
            ]
          }
        }
      ]
    }
  ]
}
